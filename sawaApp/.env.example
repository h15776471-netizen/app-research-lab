# Copy to .env locally (gitignored), or pass the same two values via
# --dart-define at build/run time. Never commit real values.
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=xxxx
#
# See lib/core/config/supabase_config.dart — the app runs fine (browsing
# only) with these left empty; only the Contact Request submission needs
# them configured.

SUPABASE_URL=
SUPABASE_ANON_KEY=
