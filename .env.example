# SAWA — Supabase credentials template
# Copy this file to .env (gitignored) and fill in your real values.
# Then pass them as --dart-define flags when running or building:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
#   flutter build web --release \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Get these values from: Supabase Dashboard → Project Settings → API
#   Project URL  → SUPABASE_URL
#   anon public  → SUPABASE_ANON_KEY
#
# The app browses fully offline without these values.
# Only contact-request submission requires them.
# See: sawaApp/lib/core/config/supabase_config.dart

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
